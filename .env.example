# Application
NODE_ENV=development
PORT=3000
API_URL=http://localhost:3000

# Database
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=school_erp
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/school_erp


# Authentication / JWT
JWT_SECRET=supersecretjwtkeychangeinproduction
JWT_EXPIRES_IN=7d
SECRET_KEY=supersecretkeyplaceholderchangeinproduction
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Redis (for caching/queues if needed)
REDIS_URL=redis://localhost:6379

# Email SMTP Settings
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_FROM=noreply@schoolerpsaas.com
